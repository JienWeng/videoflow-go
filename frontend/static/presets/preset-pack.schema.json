{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:videoflow:preset-pack:1",
  "title": "VideoFlow creative preset pack v1",
  "description": "Runtime validation additionally enforces UTF-8 byte limits, nonblank strings and unique preset IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "id",
    "name",
    "version",
    "presets"
  ],
  "properties": {
    "format": {
      "const": "videoflow.preset-pack"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "maxLength": 120
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "style_prompt",
          "guidance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "style_prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "guidance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story",
              "shots",
              "image",
              "video"
            ],
            "properties": {
              "story": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "shots": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "image": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "video": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            }
          }
        }
      }
    }
  }
}
